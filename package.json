{
  "name": "taskdeck",
  "displayName": "TaskDeck",
  "description": "A control center to manage and launch VS Code tasks.",
  "version": "0.15.0",
  "icon": "img/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kasuken/vscode-taskdeck.git"
  },
  "license": "MIT",
  "publisher": "emanuelebartolesi",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "tasks",
    "task runner",
    "task manager",
    "favorites",
    "recents",
    "quick pick",
    "productivity",
    "project",
    "automation",
    "vscode tasks",
    "activity bar",
    "side panel",
    "run tasks",
    "task explorer"
  ],
  "activationEvents": [
    "onView:taskdeck.tasksView",
    "onCommand:taskdeck.runTask",
    "onCommand:taskdeck.refreshTasks",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskdeck",
          "title": "TaskDeck",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "taskdeck": [
        {
          "id": "taskdeck.tasksView",
          "name": "Tasks"
        }
      ]
    },
    "configuration": {
      "title": "TaskDeck",
      "properties": {
        "taskdeck.excludeSources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of task source types to hide from the task list (e.g. \"extension\", \"shell\", \"Workspace\"). Use this to hide tasks automatically created by other extensions."
        }
      }
    },
    "commands": [
      {
        "command": "taskdeck.refreshTasks",
        "title": "TaskDeck: Refresh Tasks",
        "icon": "$(refresh)"
      },
      {
        "command": "taskdeck.runTask",
        "title": "TaskDeck: Run Task",
        "icon": "$(play)"
      },
      {
        "command": "taskdeck.toggleFavorite",
        "title": "TaskDeck: Toggle Favorite",
        "icon": "$(star)"
      },
      {
        "command": "taskdeck.setFilter",
        "title": "TaskDeck: Set Filter",
        "icon": "$(filter)"
      },
      {
        "command": "taskdeck.runTaskQuickPick",
        "title": "TaskDeck: Run Task…"
      },
      {
        "command": "taskdeck.sendToTaskbar",
        "title": "TaskDeck: Send to Taskbar",
        "icon": "$(pin)"
      },
      {
        "command": "taskdeck.moveFavoriteUp",
        "title": "TaskDeck: Move Favorite Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "taskdeck.moveFavoriteDown",
        "title": "TaskDeck: Move Favorite Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "taskdeck.clearFilter",
        "title": "TaskDeck: Clear Filter",
        "icon": "$(close)"
      },
      {
        "command": "taskdeck.stopTask",
        "title": "TaskDeck: Stop Running Task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskdeck.runSelectedTasks",
        "title": "TaskDeck: Run Selected Tasks",
        "icon": "$(play)"
      },
      {
        "command": "taskdeck.stopSelectedTasks",
        "title": "TaskDeck: Stop Selected Tasks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskdeck.restartTask",
        "title": "TaskDeck: Restart Running Task",
        "icon": "$(debug-restart)"
      },
      {
        "command": "taskdeck.focusTaskTerminal",
        "title": "TaskDeck: Focus Task Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "taskdeck.openTaskDefinition",
        "title": "TaskDeck: Open Task Definition",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskdeck.refreshTasks",
          "when": "view == taskdeck.tasksView",
          "group": "navigation"
        },
        {
          "command": "taskdeck.setFilter",
          "when": "view == taskdeck.tasksView",
          "group": "navigation"
        },
        {
          "command": "taskdeck.clearFilter",
          "when": "view == taskdeck.tasksView && taskdeck.hasFilter",
          "group": "navigation"
        },
        {
          "command": "taskdeck.runSelectedTasks",
          "when": "view == taskdeck.tasksView && taskdeck.canRunSelection",
          "group": "navigation"
        },
        {
          "command": "taskdeck.stopSelectedTasks",
          "when": "view == taskdeck.tasksView && taskdeck.canStopSelection",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "taskdeck.runTask",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "taskdeck.toggleFavorite",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "taskdeck.sendToTaskbar",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "inline@3"
        },
        {
          "command": "taskdeck.runTask",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "inline@1"
        },
        {
          "command": "taskdeck.moveFavoriteUp",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "inline@2"
        },
        {
          "command": "taskdeck.moveFavoriteDown",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "inline@3"
        },
        {
          "command": "taskdeck.toggleFavorite",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "inline@4"
        },
        {
          "command": "taskdeck.sendToTaskbar",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "inline@5"
        },
        {
          "command": "taskdeck.openTaskDefinition",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "1_taskdeck"
        },
        {
          "command": "taskdeck.openTaskDefinition",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "1_taskdeck"
        },
        {
          "command": "taskdeck.stopTask",
          "when": "view == taskdeck.tasksView && viewItem == runningTask",
          "group": "inline@1"
        },
        {
          "command": "taskdeck.restartTask",
          "when": "view == taskdeck.tasksView && viewItem == runningTask",
          "group": "inline@2"
        },
        {
          "command": "taskdeck.focusTaskTerminal",
          "when": "view == taskdeck.tasksView && viewItem == runningTask",
          "group": "1_taskdeck"
        },
        {
          "command": "taskdeck.toggleFavorite",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "favorites@1"
        },
        {
          "command": "taskdeck.sendToTaskbar",
          "when": "view == taskdeck.tasksView && viewItem == task",
          "group": "taskbar@1"
        },
        {
          "command": "taskdeck.toggleFavorite",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "favorites@1"
        },
        {
          "command": "taskdeck.moveFavoriteUp",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "reorder@1"
        },
        {
          "command": "taskdeck.moveFavoriteDown",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "reorder@2"
        },
        {
          "command": "taskdeck.sendToTaskbar",
          "when": "view == taskdeck.tasksView && viewItem == favoriteTask",
          "group": "taskbar@1"
        }
      ],
      "commandPalette": [
        {
          "command": "taskdeck.refreshTasks"
        },
        {
          "command": "taskdeck.runTask",
          "when": "false"
        },
        {
          "command": "taskdeck.toggleFavorite",
          "when": "false"
        },
        {
          "command": "taskdeck.setFilter"
        },
        {
          "command": "taskdeck.runTaskQuickPick"
        },
        {
          "command": "taskdeck.sendToTaskbar",
          "when": "false"
        },
        {
          "command": "taskdeck.moveFavoriteUp",
          "when": "false"
        },
        {
          "command": "taskdeck.moveFavoriteDown",
          "when": "false"
        },
        {
          "command": "taskdeck.clearFilter",
          "when": "taskdeck.hasFilter"
        },
        {
          "command": "taskdeck.stopTask",
          "when": "false"
        },
        {
          "command": "taskdeck.runSelectedTasks",
          "when": "false"
        },
        {
          "command": "taskdeck.stopSelectedTasks",
          "when": "false"
        },
        {
          "command": "taskdeck.restartTask",
          "when": "false"
        },
        {
          "command": "taskdeck.focusTaskTerminal",
          "when": "false"
        },
        {
          "command": "taskdeck.openTaskDefinition",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
